# Exemplo de variáveis de ambiente. Copie para .env e ajuste os valores.
# NÃO versione o .env real com segredos.

# ---------------------------------------------------------------------------
# Banco de dados (MySQL)
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=projeto
DATABASE_USER=root
DATABASE_PASSWORD=sua_senha_aqui
DATABASE_URL=mysql://root:sua_senha_aqui@localhost:3306/projeto

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta da API (default 9090).
PORT=9090
# Em produção use "production" para não vazar detalhes de erro na resposta.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Autenticação (JWT) — OBRIGATÓRIO
# ---------------------------------------------------------------------------
# Segredo usado para assinar os tokens. Gere um valor longo e aleatório.
# A API não sobe sem ele.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Expiração do token em segundos (default 28800 = 8h).
JWT_EXPIRES_IN_SECONDS=28800

# ---------------------------------------------------------------------------
# CORS — origens permitidas (lista separada por vírgula)
# ---------------------------------------------------------------------------
# Default já cobre o dev server do Vite (5173 e 5174).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Limite de tamanho do corpo JSON
# ---------------------------------------------------------------------------
JSON_BODY_LIMIT=100kb

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Limitador global (todas as rotas).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Limitador restritivo das rotas de login (/auth) contra força-bruta.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Proxy reverso
# ---------------------------------------------------------------------------
# Deixe em branco em dev (sem proxy). Atrás de um proxy reverso (ex. nginx),
# defina o nº de saltos confiáveis (ex. 1) para o rate-limit ver o IP real.
# Aceita número, "true"/"false" ou um valor do Express (ex. "loopback").
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Registro de requisições (tela do admin)
# ---------------------------------------------------------------------------
# Quantos dias guardar o histórico de requisições. Os mais antigos são apagados
# automaticamente uma vez por dia. 0 = guardar para sempre.
# REQUISICOES_RETENCAO_DIAS=90
# Consultas (GET) que deram certo e foram rápidas não são registradas, para
# economizar espaço; alterações, erros e consultas lentas sempre são.
# true = registrar também todas as consultas.
# REQUISICOES_REGISTRAR_CONSULTAS=false
