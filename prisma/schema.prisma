// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

// Unidade de medida de um produto. Cada empresa escolhe a unidade por produto.
enum UnidadeMedida {
  KG
  CAIXA
  PCT
}

// Administrador global do sistema. Cadastra empresas e tem acesso total
// (pode operar os dados de qualquer empresa informando a empresa-alvo).
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  cnpj         String?  @unique
  senha        String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  registrosLogin RegistroLogin[]
  requisicoes    RegistroRequisicao[]

  @@map("admins")
}

// Tenant do sistema. Cada empresa possui seus próprios dados isolados.
model Empresa {
  id                 Int      @id @default(autoincrement())
  cnpj               String   @unique
  razaoSocial        String   @map("razao_social")
  nomeFantasia       String?  @map("nome_fantasia")
  inscricaoEstadual  String?  @map("inscricao_estadual")
  inscricaoMunicipal String?  @map("inscricao_municipal")
  endereco           String?
  email              String   @unique
  senha              String
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now()) @map("criado_em")
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  fornecedoresClientes FornecedorCliente[]
  contas               Conta[]
  categorias           Categoria[]
  produtos             Produto[]
  lancamentos          Lancamento[]
  movimentacoes        Movimentacao[]
  registrosLogin       RegistroLogin[]
  requisicoes          RegistroRequisicao[]

  @@map("empresas")
}

model FornecedorCliente {
  id           Int          @id @default(autoincrement())
  nome         String
  saldo        Decimal      @default(0) @db.Decimal(10, 2)
  ativo        Boolean      @default(true)
  empresaId     Int            @map("empresa_id")
  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  lancamentos   Lancamento[]
  movimentacoes Movimentacao[]
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime       @updatedAt @map("atualizado_em")

  // nome único por empresa (não globalmente)
  @@unique([empresaId, nome])
  @@map("fornecedores_clientes")
}

model Conta {
  id          Int          @id @default(autoincrement())
  nome        String
  empresaId   Int          @map("empresa_id")
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  lancamentos Lancamento[]

  @@unique([empresaId, nome])
  @@map("contas")
}

model Categoria {
  id          Int          @id @default(autoincrement())
  nome        String
  empresaId   Int          @map("empresa_id")
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  lancamentos Lancamento[]

  @@unique([empresaId, nome])
  @@map("categorias")
}

model Lancamento {
  id                  Int                @id @default(autoincrement())
  dataLancamento      DateTime           @map("data_lancamento")
  tipo                TipoLancamento
  valor               Decimal            @db.Decimal(10, 2)
  classificacao       String?
  observacao          String?            @db.Text

  empresaId           Int                @map("empresa_id")
  fornecedorClienteId Int                @map("fornecedor_cliente_id")
  contaId             Int                @map("conta_id")
  categoriaId         Int                @map("categoria_id")

  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  fornecedorCliente   FornecedorCliente  @relation(fields: [fornecedorClienteId], references: [id])
  conta               Conta              @relation(fields: [contaId], references: [id])
  categoria           Categoria          @relation(fields: [categoriaId], references: [id])

  criadoEm            DateTime           @default(now()) @map("criado_em")
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em")

  @@index([empresaId, dataLancamento])
  @@map("lancamentos")
}

// Movimentação de mercadoria/valores de um fornecedor/cliente.
// ENTRADA (compra/recebimento) soma no saldo do fornecedor/cliente (a pagar);
// SAIDA (venda) subtrai do saldo (a receber) — mesma convenção do Lancamento.
// Produto comercializado pela empresa, com sua unidade de medida.
model Produto {
  id            Int            @id @default(autoincrement())
  nome          String
  unidadeMedida UnidadeMedida  @map("unidade_medida")
  empresaId     Int            @map("empresa_id")
  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  movimentacoes Movimentacao[]
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime       @updatedAt @map("atualizado_em")

  // nome único por empresa (não globalmente)
  @@unique([empresaId, nome])
  @@map("produtos")
}

model Movimentacao {
  id                  Int               @id @default(autoincrement())
  dataMovimento       DateTime          @map("data_movimento")
  tipo                TipoMovimentacao
  quantidade          Decimal?          @db.Decimal(10, 2)
  preco               Decimal?          @db.Decimal(10, 2)
  total               Decimal           @db.Decimal(10, 2)
  valorDetalhado      String?           @map("valor_detalhado")
  nf                  String?
  motorista           String?
  veiculo             String?
  transportadora      String?
  descricao           String?           @db.Text

  empresaId           Int               @map("empresa_id")
  fornecedorClienteId Int               @map("fornecedor_cliente_id")
  produtoId           Int?              @map("produto_id")

  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  fornecedorCliente   FornecedorCliente @relation(fields: [fornecedorClienteId], references: [id])
  produto             Produto?          @relation(fields: [produtoId], references: [id])

  criadoEm            DateTime          @default(now()) @map("criado_em")
  atualizadoEm        DateTime          @updatedAt @map("atualizado_em")

  @@index([empresaId, dataMovimento])
  @@map("movimentacoes")
}

enum TipoAcesso {
  ADMIN
  EMPRESA
}

enum TipoDispositivo {
  COMPUTADOR
  CELULAR
  TABLET
  DESCONHECIDO
}

// Cada tentativa de login (com sucesso ou não), com o dispositivo de origem.
// Consultado pelo administrador. Admin/empresa ficam como SetNull para o
// histórico sobreviver à exclusão do cadastro; nomeUsuario guarda o nome da
// época para a linha continuar legível.
model RegistroLogin {
  id              Int             @id @default(autoincrement())
  tipoAcesso      TipoAcesso      @map("tipo_acesso")
  sucesso         Boolean
  // motivo da falha (null quando deu certo)
  motivo          String?         @db.VarChar(100)
  // o que foi digitado no campo de usuário (CNPJ ou e-mail)
  identificador   String          @db.VarChar(191)
  nomeUsuario     String?         @map("nome_usuario") @db.VarChar(191)

  adminId         Int?            @map("admin_id")
  empresaId       Int?            @map("empresa_id")
  admin           Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  empresa         Empresa?        @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  ip              String?         @db.VarChar(64)
  userAgent       String?         @map("user_agent") @db.Text
  tipoDispositivo TipoDispositivo @map("tipo_dispositivo")
  sistema         String?         @db.VarChar(64)
  navegador       String?         @db.VarChar(64)
  modelo          String?         @db.VarChar(100)

  criadoEm        DateTime        @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@index([empresaId, criadoEm])
  @@map("registros_login")
}

// Cada requisição feita à API (exceto login, que tem registro próprio, e as
// telas de consulta dos próprios registros). Gravado em lote, depois da
// resposta. Não guarda o corpo da requisição (pode ter dados sensíveis).
model RegistroRequisicao {
  id              Int              @id @default(autoincrement())
  metodo          String           @db.VarChar(10)
  // caminho real (ex: /lancamentos/12) e o modelo dele (ex: /lancamentos/:id)
  caminho         String           @db.VarChar(255)
  rota            String           @db.VarChar(255)
  consulta        String?          @db.VarChar(500)
  status          Int              @db.SmallInt
  duracaoMs       Int              @map("duracao_ms")

  // quem fez: null quando a requisição não estava autenticada
  tipoAcesso      TipoAcesso?      @map("tipo_acesso")
  adminId         Int?             @map("admin_id")
  // empresa alvo (a própria, ou a que o admin estava visualizando)
  empresaId       Int?             @map("empresa_id")
  admin           Admin?           @relation(fields: [adminId], references: [id], onDelete: SetNull)
  empresa         Empresa?         @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  ip              String?          @db.VarChar(64)
  tipoDispositivo TipoDispositivo  @map("tipo_dispositivo")
  sistema         String?          @db.VarChar(64)
  navegador       String?          @db.VarChar(64)

  criadoEm        DateTime         @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@index([empresaId, criadoEm])
  @@index([status, criadoEm])
  @@map("registros_requisicoes")
}
