// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

// Unidade de medida de um produto. Cada empresa escolhe a unidade por produto.
enum UnidadeMedida {
  KG
  CAIXA
  PCT
}

// Administrador global do sistema. Cadastra empresas e tem acesso total
// (pode operar os dados de qualquer empresa informando a empresa-alvo).
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  senha        String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("admins")
}

// Tenant do sistema. Cada empresa possui seus próprios dados isolados.
model Empresa {
  id                 Int      @id @default(autoincrement())
  cnpj               String   @unique
  razaoSocial        String   @map("razao_social")
  nomeFantasia       String?  @map("nome_fantasia")
  inscricaoEstadual  String?  @map("inscricao_estadual")
  inscricaoMunicipal String?  @map("inscricao_municipal")
  endereco           String?
  email              String   @unique
  senha              String
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now()) @map("criado_em")
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  fornecedoresClientes FornecedorCliente[]
  contas               Conta[]
  categorias           Categoria[]
  produtos             Produto[]
  lancamentos          Lancamento[]
  movimentacoes        Movimentacao[]

  @@map("empresas")
}

model FornecedorCliente {
  id           Int          @id @default(autoincrement())
  nome         String
  saldo        Decimal      @default(0) @db.Decimal(10, 2)
  ativo        Boolean      @default(true)
  empresaId     Int            @map("empresa_id")
  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  lancamentos   Lancamento[]
  movimentacoes Movimentacao[]
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime       @updatedAt @map("atualizado_em")

  // nome único por empresa (não globalmente)
  @@unique([empresaId, nome])
  @@map("fornecedores_clientes")
}

model Conta {
  id          Int          @id @default(autoincrement())
  nome        String
  empresaId   Int          @map("empresa_id")
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  lancamentos Lancamento[]

  @@unique([empresaId, nome])
  @@map("contas")
}

model Categoria {
  id          Int          @id @default(autoincrement())
  nome        String
  empresaId   Int          @map("empresa_id")
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  lancamentos Lancamento[]

  @@unique([empresaId, nome])
  @@map("categorias")
}

model Lancamento {
  id                  Int                @id @default(autoincrement())
  dataLancamento      DateTime           @map("data_lancamento")
  tipo                TipoLancamento
  valor               Decimal            @db.Decimal(10, 2)
  classificacao       String?
  observacao          String?            @db.Text

  empresaId           Int                @map("empresa_id")
  fornecedorClienteId Int                @map("fornecedor_cliente_id")
  contaId             Int                @map("conta_id")
  categoriaId         Int                @map("categoria_id")

  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  fornecedorCliente   FornecedorCliente  @relation(fields: [fornecedorClienteId], references: [id])
  conta               Conta              @relation(fields: [contaId], references: [id])
  categoria           Categoria          @relation(fields: [categoriaId], references: [id])

  criadoEm            DateTime           @default(now()) @map("criado_em")
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em")

  @@index([empresaId, dataLancamento])
  @@map("lancamentos")
}

// Movimentação de mercadoria/valores de um fornecedor/cliente.
// ENTRADA (compra/recebimento) soma no saldo do fornecedor/cliente (a pagar);
// SAIDA (venda) subtrai do saldo (a receber) — mesma convenção do Lancamento.
// Produto comercializado pela empresa, com sua unidade de medida.
model Produto {
  id            Int            @id @default(autoincrement())
  nome          String
  unidadeMedida UnidadeMedida  @map("unidade_medida")
  empresaId     Int            @map("empresa_id")
  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  movimentacoes Movimentacao[]
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime       @updatedAt @map("atualizado_em")

  // nome único por empresa (não globalmente)
  @@unique([empresaId, nome])
  @@map("produtos")
}

model Movimentacao {
  id                  Int               @id @default(autoincrement())
  dataMovimento       DateTime          @map("data_movimento")
  tipo                TipoMovimentacao
  quantidade          Decimal?          @db.Decimal(10, 2)
  preco               Decimal?          @db.Decimal(10, 2)
  total               Decimal           @db.Decimal(10, 2)
  valorDetalhado      String?           @map("valor_detalhado")
  nf                  String?
  motorista           String?
  veiculo             String?
  transportadora      String?
  descricao           String?           @db.Text

  empresaId           Int               @map("empresa_id")
  fornecedorClienteId Int               @map("fornecedor_cliente_id")
  produtoId           Int?              @map("produto_id")

  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  fornecedorCliente   FornecedorCliente @relation(fields: [fornecedorClienteId], references: [id])
  produto             Produto?          @relation(fields: [produtoId], references: [id])

  criadoEm            DateTime          @default(now()) @map("criado_em")
  atualizadoEm        DateTime          @updatedAt @map("atualizado_em")

  @@index([empresaId, dataMovimento])
  @@map("movimentacoes")
}
